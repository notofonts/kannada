code = "lookup SingleSubstitution10 {\012    sub viramaknda by kasubscriptknda;\012    sub kassaknda by ssasubscriptknda;\012} SingleSubstitution10;\012\012lookup SingleSubstitution11 {\012    sub viramaknda by jasubscriptknda;\012    sub janyaknda by nyasubscriptknda;\012} SingleSubstitution11;\012\012lookup SingleSubstitution13 {\012    sub kaknda by kasubscriptknda;\012    sub khaknda by khasubscriptknda;\012    sub paknda by pasubscriptknda;\012    sub phaknda by phasubscriptknda;\012    sub raknda by rvocalicknda;\012    sub rvocalicvowelsignknda by rephknda;\012} SingleSubstitution13;\012\012lookup SingleSubstitution23 {\012    sub aavowelsignknda by phanuktasubscriptknda;\012    sub ivowelsignknda by phanuktasubscriptknda;\012    sub uvowelsignknda by phanuktasubscriptknda;\012    sub uuvowelsignknda by phanuktasubscriptknda;\012    sub evowelsignknda by phanuktasubscriptknda;\012    sub auvowelsignknda by phanuktasubscriptknda;\012} SingleSubstitution23;\012\012# Janukta/Phanukta <-> Vowel sign swaps\012\012lookup SingleSubstitution21 {\012    sub januktasubscriptknda by auvowelsignknda;\012    sub phanuktasubscriptknda by auvowelsignknda;\012} SingleSubstitution21;\012\012lookup SingleSubstitution19 {\012    sub januktasubscriptknda by uvowelsignknda;\012    sub phanuktasubscriptknda by uvowelsignknda;\012} SingleSubstitution19;\012\012lookup SingleSubstitution18 {\012    sub januktasubscriptknda by evowelsignknda;\012    sub phanuktasubscriptknda by evowelsignknda;\012} SingleSubstitution18;\012\012lookup SingleSubstitution17 {\012    sub januktasubscriptknda by ivowelsignknda;\012    sub phanuktasubscriptknda by ivowelsignknda;\012} SingleSubstitution17;\012\012lookup SingleSubstitution16 {\012    sub januktasubscriptknda by aavowelsignknda;\012    sub phanuktasubscriptknda by aavowelsignknda;\012} SingleSubstitution16;\012\012lookup SingleSubstitution22 {\012    sub aavowelsignknda by januktasubscriptknda;\012    sub ivowelsignknda by januktasubscriptknd